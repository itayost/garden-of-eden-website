{
  "permissions": {
    "allow": [
      "Bash(xargs -I{} sh -c 'test -f \"{}\" && echo \"keystore exists\" || echo \"keystore MISSING at {}\"')",
      "Bash(./gradlew bundleRelease --console=plain -q)",
      "mcp__claude_ai_Vercel__get_runtime_errors",
      "Bash(sips -g pixelWidth -g pixelHeight '/Users/itayostraich/Downloads/WhatsApp Image 2026-08-11 at 11.42.09.jpeg')",
      "Bash(sips -g pixelWidth -g pixelHeight served.webp)",
      "Bash(sips -g pixelWidth -g pixelHeight live-ido.webp)",
      "Bash(xargs -0 grep -ho \"slide-in-from-bottom[^{,: ]*\")",
      "Bash(awk -F_ '{print $1}')"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$CLAUDE_FILE_PATH\" in *.env*) echo 'BLOCK: Do not edit .env files directly' >&2; exit 2;; esac"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$CLAUDE_FILE_PATH\" in *.ts|*.tsx|*.js|*.jsx|*.mjs) npx eslint --fix \"$CLAUDE_FILE_PATH\" 2>/dev/null || true;; esac"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$CLAUDE_FILE_PATH\" in *.ts|*.tsx) npx tsc --noEmit --pretty 2>&1 | head -20 || true;; esac"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": false,
    "firebase@claude-plugins-official": false
  }
}
