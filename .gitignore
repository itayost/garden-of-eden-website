# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# worktrees
/.worktrees

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.auth
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log

# data files
*.csv

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# tool artifacts
.playwright-mcp/
.superpowers/
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Retention/data-repair rollback dumps. Contain member names and phone numbers.
# Keep on disk for rollback, never in git history.
scripts/backups/

# graphify local artifacts (only docs/graph/GRAPH_REPORT.md is committed)
graphify-out/
